{
  "name": "rekolor-web",
  "private": true,
  "description": "reKolor web app: preview a picture printed with a limited ink palette (Svelte + the rekolor-wasm package in a Web Worker)",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../rust/crates/wasm --release --target web",
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "smoke": "node scripts/smoke.mjs",
    "prepare": "cd .. && husky"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "rekolor-wasm": "file:../rust/crates/wasm/pkg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents": false
  }
}
